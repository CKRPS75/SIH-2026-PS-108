APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://standardwise:password@postgres:5432/standardwise
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=standards_v1
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_MODE=disabled
QUERY_INTERPRETER_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_WARMUP_ON_STARTUP=true
TRANSLATION_PROVIDER=indictrans2
LLM_PROVIDER=ollama
LLM_MODEL=llama3:8b
DENSE_K=30
BM25_K=30
RERANK_K=20
RETURN_K=5
UPLOAD_MAX_MB=25
LOG_LEVEL=INFO
